page {
  min-height: 100%;
  color: #17221d;
  background: #f4f0e6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  font-weight: 600;
}

button::after {
  border: none;
}

.page-shell {
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.panel {
  background: #fffdf7;
  border: 2rpx solid rgba(23, 34, 29, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(21, 48, 38, 0.08);
}

.primary-button {
  color: #ffffff;
  background: #d66b3d;
  border-radius: 999rpx;
}

.secondary-button {
  color: #173c30;
  background: #e0eee7;
  border-radius: 999rpx;
}

.eyebrow {
  color: #bd5b33;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.result-stats {
  display: flex;
  margin-top: 18rpx;
  padding: 18rpx 10rpx;
  box-shadow: none;
}

.result-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid #ece6da;
}

.result-stat:last-child {
  border-right: 0;
}

.result-stat-value {
  color: #173c30;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.result-stat-label {
  margin-top: 7rpx;
  color: #829087;
  font-size: 19rpx;
}
