.intro { padding: 18rpx 8rpx 30rpx; }
.page-title { margin-top: 10rpx; font-size: 52rpx; font-weight: 800; }
.page-copy { margin-top: 12rpx; color: #647169; font-size: 26rpx; line-height: 1.55; }

.length-panel { margin-bottom: 24rpx; padding: 30rpx; }
.length-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.length-title { display: block; font-size: 28rpx; font-weight: 750; }
.length-note { display: block; margin-top: 6rpx; color: #849087; font-size: 21rpx; }
.length-value { color: #8c6a58; font-size: 24rpx; }
.length-value text { margin-right: 6rpx; color: #d66b3d; font-size: 46rpx; font-weight: 800; }
.length-scale { display: flex; justify-content: space-between; padding: 0 13rpx; color: #9aa39d; font-size: 19rpx; }

.player { padding: 30rpx; }
.button-row { display: flex; }
.random-button, .replay-button { display: flex; align-items: center; justify-content: center; height: 96rpx; margin: 0; font-size: 27rpx; line-height: 1; }
.random-button { flex: 1; }
.replay-button { width: 180rpx; margin-left: 18rpx; color: #173c30; background: #e0eee7; border-radius: 999rpx; }
.play-icon { margin-right: 14rpx; font-size: 25rpx; }
.replay-icon { margin-right: 8rpx; font-size: 36rpx; }
.play-hint { display: flex; align-items: center; justify-content: center; margin-top: 24rpx; color: #7c8981; font-size: 22rpx; }
.status-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; background: #aeb7b1; border-radius: 50%; }
.status-dot.active { background: #48758b; box-shadow: 0 0 0 7rpx rgba(72, 117, 139, .12); }

.answer-area { display: flex; align-items: center; margin-top: 34rpx; }
.box-group { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; }
.box-label { margin-bottom: 14rpx; color: #536159; font-size: 25rpx; font-weight: 700; }
.word-box { display: flex; align-items: center; justify-content: center; width: 280rpx; height: 210rpx; padding: 0 12rpx; box-sizing: border-box; color: #17221d; background: #fffdf7; border: 4rpx solid #ded7c9; border-radius: 28rpx; box-shadow: 0 10rpx 26rpx rgba(21, 48, 38, .07); font-size: 34rpx; font-weight: 800; letter-spacing: 3rpx; text-align: center; }
.input-box { padding: 0 14rpx; }
.word-box.correct { color: #216448; background: #e2f2e8; border-color: #4c9873; }
.word-box.wrong { color: #ad432b; background: #f9e6df; border-color: #d36d53; }
.reveal-box.hidden { color: #607168; background: #e9eee9; border-style: dashed; }
.hidden-content { display: flex; flex-direction: column; align-items: center; font-size: 23rpx; font-weight: 600; letter-spacing: 0; }
.eye-icon { margin-bottom: 14rpx; font-size: 42rpx; }
.answer-word { font-size: 34rpx; font-weight: 800; letter-spacing: 3rpx; }
.reveal-pressed { transform: scale(.97); }
.compare-mark { width: 68rpx; padding-top: 38rpx; color: #8b958f; font-size: 25rpx; font-weight: 700; text-align: center; }
.box-note { margin-top: 14rpx; color: #8a958e; font-size: 20rpx; text-align: center; }

.feedback { display: flex; align-items: center; margin-top: 30rpx; padding: 24rpx 28rpx; border-radius: 20rpx; font-size: 24rpx; }
.feedback.success { color: #205d43; background: #dceee3; }
.feedback.error { color: #9e3d29; background: #f5dfd7; }
.feedback-icon { width: 46rpx; height: 46rpx; margin-right: 16rpx; color: #fff; border-radius: 50%; line-height: 43rpx; text-align: center; }
.feedback.success .feedback-icon { background: #3f8a68; }
.feedback.error .feedback-icon { background: #c75d43; }
