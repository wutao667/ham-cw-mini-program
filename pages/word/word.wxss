.intro { padding: 6rpx 8rpx 22rpx; }
.page-title { margin-top: 10rpx; font-size: 46rpx; font-weight: 800; }
.page-copy { margin-top: 8rpx; color: #647169; font-size: 23rpx; line-height: 1.5; }
.training-panel { margin-bottom: 20rpx; padding: 24rpx; }
.option-title { color: #536159; font-size: 24rpx; font-weight: 700; }
.type-options { display: flex; margin: 16rpx -4rpx 0; }
.type-option { flex: 1; min-width: 0; margin: 0 4rpx; padding: 0; height: 64rpx; line-height: 64rpx; color: #647169; background: #f1eee5; border-radius: 12rpx; font-size: 23rpx; }
.type-option.selected { color: #fff; background: #173c30; }
.scene-picker { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 14rpx 0; border-bottom: 2rpx solid #ece6da; }
.scene-value { color: #173c30; font-size: 24rpx; }
.picker-arrow { margin-left: 12rpx; color: #829087; }
.difficulty-options { display: flex; margin: 18rpx -4rpx 0; }
.difficulty-option { flex: 1; margin: 0 4rpx; padding: 0; height: 56rpx; line-height: 56rpx; background: #f1eee5; color: #647169; border-radius: 10rpx; font-size: 22rpx; }
.difficulty-option.selected { color: #9e4827; background: #f7e5d9; }
.training-note { margin-top: 12rpx; color: #849087; font-size: 20rpx; line-height: 1.5; }
.length-section { margin-top: 22rpx; }
.length-head { display: flex; align-items: center; justify-content: space-between; }
.length-value { color: #d66b3d; font-size: 27rpx; font-weight: 700; }
.length-scale { display: flex; justify-content: space-between; padding: 0 12rpx; color: #9aa39d; font-size: 19rpx; }
.player { padding: 22rpx; }
.button-row { display: flex; }
.random-button, .replay-button { display: flex; align-items: center; justify-content: center; height: 80rpx; margin: 0; font-size: 26rpx; line-height: 1; }
.random-button { flex: 1; }
.replay-button { width: 170rpx; margin-left: 16rpx; color: #173c30; background: #e0eee7; border-radius: 999rpx; }
.play-icon { margin-right: 12rpx; font-size: 24rpx; }
.replay-icon { margin-right: 8rpx; font-size: 28rpx; }
.play-hint { display: flex; align-items: center; justify-content: center; margin-top: 18rpx; color: #7c8981; font-size: 20rpx; }
.status-dot { flex-shrink: 0; width: 10rpx; height: 10rpx; margin-right: 10rpx; background: #aeb7b1; border-radius: 50%; }
.status-dot.active { background: #48758b; box-shadow: 0 0 0 6rpx rgba(72, 117, 139, .12); }
.answer-area { margin-top: 24rpx; }
.box-label { margin: 0 8rpx 10rpx; color: #536159; font-size: 23rpx; font-weight: 700; }
.word-input, .reveal-box { width: 100%; box-sizing: border-box; color: #17221d; background: #fffdf7; border: 3rpx solid #ded7c9; border-radius: 20rpx; font-size: 29rpx; line-height: 1.65; letter-spacing: 1rpx; }
.word-input { display: block; min-height: 146rpx; padding: 20rpx 24rpx; }
.box-note { margin: 9rpx 8rpx 0; color: #8a958e; font-size: 19rpx; line-height: 1.5; }
.answer-label { margin-top: 20rpx; }
.reveal-box { display: flex; align-items: center; min-height: 116rpx; padding: 20rpx 24rpx; }
.reveal-box.hidden { justify-content: center; color: #607168; background: #e9eee9; border-style: dashed; }
.hidden-content { display: flex; align-items: center; font-size: 23rpx; letter-spacing: 0; }
.eye-icon { margin-right: 14rpx; font-size: 32rpx; }
.answer-word { font-weight: 700; white-space: pre-wrap; word-break: break-all; }
.correct { color: #216448; background: #e2f2e8; border-color: #4c9873; }
.wrong { color: #ad432b; background: #f9e6df; border-color: #d36d53; }
.reveal-pressed { opacity: .85; }
.answer-detail { padding: 14rpx 8rpx 0; font-size: 21rpx; line-height: 1.6; }
.exercise-label { display: block; color: #48758b; font-weight: 700; }
.exercise-hint { display: block; margin-top: 4rpx; color: #647169; }
.feedback { margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 16rpx; font-size: 22rpx; line-height: 1.5; }
.feedback.success { color: #205d43; background: #dceee3; }
.feedback.error { color: #9e3d29; background: #f5dfd7; }
.practice-note { margin: 20rpx 8rpx 0; color: #8a958e; font-size: 19rpx; line-height: 1.5; text-align: center; }
