.intro { padding: 18rpx 8rpx 30rpx; }
.page-title { margin-top: 10rpx; font-size: 52rpx; font-weight: 800; }
.page-copy { margin-top: 12rpx; color: #647169; font-size: 26rpx; line-height: 1.55; }

.settings-card { margin-bottom: 24rpx; padding: 32rpx; }
.setting-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.setting-title { display: block; font-size: 29rpx; font-weight: 750; }
.setting-description { display: block; margin-top: 6rpx; color: #89938d; font-size: 21rpx; }
.setting-value { color: #9b6147; font-size: 22rpx; }
.setting-value text { color: #d66b3d; font-size: 42rpx; font-weight: 800; }
.setting-value.green, .setting-value.green text { color: #31755d; }
.presets { display: flex; margin-top: 14rpx; }
.preset { flex: 1; height: 64rpx; margin: 0 7rpx; padding: 0; color: #647169; background: #f0ede5; border-radius: 12rpx; font-size: 23rpx; line-height: 64rpx; }
.preset:first-child { margin-left: 0; }
.preset:last-child { margin-right: 0; }
.preset.active { color: #fff; background: #d66b3d; }
.frequency-scale { display: flex; justify-content: space-between; padding: 0 10rpx; color: #9ba49f; font-size: 19rpx; }

.standard-card { padding: 34rpx 32rpx 30rpx; }
.standard-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 26rpx; border-bottom: 2rpx solid #eee9dd; }
.standard-title { display: block; font-size: 30rpx; font-weight: 750; }
.standard-note { display: block; margin-top: 6rpx; color: #89938d; font-size: 21rpx; }
.standard-badge { padding: 12rpx 16rpx; color: #fff; background: #173c30; border-radius: 12rpx; font-size: 22rpx; font-weight: 700; }
.timing-list { padding-top: 8rpx; }
.timing-row { display: flex; align-items: center; min-height: 104rpx; border-bottom: 2rpx solid #f0ece3; }
.timing-row:last-child { border-bottom: 0; }
.symbol { flex-shrink: 0; margin-right: 24rpx; background: #d66b3d; border-radius: 99rpx; }
.symbol.dot { width: 18rpx; height: 18rpx; margin-left: 25rpx; margin-right: 49rpx; }
.symbol.dash { width: 68rpx; height: 18rpx; }
.symbol.gap { height: 8rpx; background: repeating-linear-gradient(90deg, #81958a 0, #81958a 7rpx, transparent 7rpx, transparent 14rpx); border-radius: 0; }
.symbol.character { width: 68rpx; }
.symbol.word { width: 68rpx; background: repeating-linear-gradient(90deg, #48758b 0, #48758b 4rpx, transparent 4rpx, transparent 10rpx); }
.timing-name { display: flex; flex: 1; flex-direction: column; }
.timing-name text:first-child { font-size: 25rpx; font-weight: 700; }
.timing-name text:last-child { margin-top: 5rpx; color: #8b958f; font-size: 20rpx; }
.timing-ms { color: #596860; font-size: 23rpx; font-weight: 700; }
.inner-gap { margin-top: 20rpx; padding: 20rpx; color: #596860; background: #edf2ed; border-radius: 14rpx; font-size: 21rpx; line-height: 1.5; }

.preview-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 108rpx; margin-top: 28rpx; color: #fff; background: #48758b; border-radius: 24rpx; line-height: 1.3; }
.preview-button.playing { background: #31755d; }
.preview-icon { margin-right: 24rpx; font-size: 34rpx; }
.preview-button view { display: flex; flex-direction: column; align-items: flex-start; }
.preview-title { font-size: 28rpx; font-weight: 750; }
.preview-code { margin-top: 6rpx; color: #d7e5ea; font-size: 20rpx; letter-spacing: 2rpx; }
.save-note { margin-top: 24rpx; color: #929c96; font-size: 21rpx; text-align: center; }
