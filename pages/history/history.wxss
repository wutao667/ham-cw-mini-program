.intro {
  padding: 6rpx 8rpx 22rpx;
}

.page-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 800;
}

.chart-card {
  padding: 28rpx 22rpx 20rpx;
}

.chart-header,
.history-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 750;
}

.record-total,
.history-order {
  color: #829087;
  font-size: 19rpx;
}

.chart-legend {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  color: #66736b;
  font-size: 19rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.legend-line {
  width: 30rpx;
  height: 6rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
}

.accuracy-line {
  background: #3f8a68;
}

.time-line {
  background: #d66b3d;
}

.score-chart {
  display: block;
  width: 100%;
  height: 390rpx;
  margin-top: 8rpx;
}

.empty-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: #8a958e;
  font-size: 22rpx;
}

.empty-chart-icon {
  margin-bottom: 16rpx;
  color: #9db4a8;
  font-size: 56rpx;
}

.history-heading {
  margin: 28rpx 4rpx 14rpx;
}

.record-card {
  margin-bottom: 14rpx;
  padding: 22rpx 18rpx;
  box-shadow: none;
}

.record-time {
  padding: 0 8rpx 16rpx;
  color: #536159;
  border-bottom: 2rpx solid #ece6da;
  font-size: 22rpx;
  font-weight: 700;
}

.record-metrics {
  display: flex;
  padding-top: 18rpx;
}

.record-metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  border-right: 2rpx solid #ece6da;
}

.record-metric:last-child {
  border-right: 0;
}

.metric-value {
  color: #173c30;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.metric-label {
  margin-top: 8rpx;
  color: #829087;
  font-size: 17rpx;
  white-space: nowrap;
}

.empty-list {
  padding: 72rpx 0;
  color: #8a958e;
  font-size: 22rpx;
  text-align: center;
}
